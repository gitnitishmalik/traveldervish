# Cloudflare Pages settings (the same rules as .htaccess, which only Hostinger uses).
# HTTPS, Brotli/Gzip compression and the 404 page (404.html) are handled by Cloudflare automatically.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN

# Script carries a version tag (?v=...) that changes on every build: keep it for a year
/assets/js/*
  Cache-Control: public, max-age=31536000, immutable

/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Photos, videos and PDFs keep their names when swapped: 30 days
/assets/img/*
  Cache-Control: public, max-age=2592000

/assets/video/*
  Cache-Control: public, max-age=2592000

/assets/pdf/*
  Cache-Control: public, max-age=2592000

# Hostinger-only file: never needed on Cloudflare
/.htaccess
  X-Robots-Tag: noindex
