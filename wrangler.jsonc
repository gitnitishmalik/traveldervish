// Cloudflare settings for the "traveldervish" project (used by `npx wrangler deploy` on every push)
{
  "name": "traveldervish",
  "compatibility_date": "2026-11-27",
  "assets": {
    // the finished website
    "directory": "./website",
    // show website/404.html (with a 404 status) for addresses that don't exist
    "not_found_handling": "404-page"
  }
}
